package ui;

import dao.StudentDAO;
import model.Student;

import javax.swing.*;
import java.awt.*;

public class NewStudentFrame extends JFrame {

    public NewStudentFrame() {
        setTitle("Register New Student");
        setSize(500, 350);
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
        setLocationRelativeTo(null);
        setResizable(false);

        // Background panel setup
        BackgroundPanel backgroundPanel = new BackgroundPanel("/images/Student_login_bg.jpg");
        backgroundPanel.setLayout(null);
        setContentPane(backgroundPanel);

        // Title Label
        JLabel titleLabel = new JLabel("Register New Student");
        titleLabel.setFont(new Font("MV Boli", Font.BOLD, 20));
        titleLabel.setForeground(Color.BLUE);
        titleLabel.setBounds(130, 40, 250, 30);
        backgroundPanel.add(titleLabel);

        // Student ID
        JLabel studentIDLabel = new JLabel("Student ID:");
        studentIDLabel.setFont(new Font("Arial", Font.BOLD, 16));
        studentIDLabel.setForeground(Color.BLACK);
        studentIDLabel.setBounds(50, 100, 120, 25);
        backgroundPanel.add(studentIDLabel);
        
        JTextField studentIDField = new JTextField();
        studentIDField.setBounds(180, 100, 250, 25);
        backgroundPanel.add(studentIDField);

        // Name
        JLabel nameLabel = new JLabel("Name:");
        nameLabel.setFont(new Font("Arial", Font.BOLD, 16));
        nameLabel.setForeground(Color.WHITE);
        nameLabel.setBounds(50, 140, 120, 25);
        backgroundPanel.add(nameLabel);
        
        JTextField nameField = new JTextField();
        nameField.setBounds(180, 140, 250, 25);
        backgroundPanel.add(nameField);

        // Email (optional)
        JLabel emailLabel = new JLabel("Email:");
        emailLabel.setFont(new Font("Arial", Font.BOLD, 16));
        emailLabel.setForeground(Color.WHITE);
        emailLabel.setBounds(50, 180, 120, 25);
        backgroundPanel.add(emailLabel);
        
        JTextField emailField = new JTextField();
        emailField.setBounds(180, 180, 250, 25);
        backgroundPanel.add(emailField);

        // Save Button
        JButton saveButton = new JButton("Save");
        saveButton.setBounds(180, 230, 120, 30);
        saveButton.setBackground(Color.GREEN);
        saveButton.setFont(new Font("Arial", Font.BOLD, 16));
        saveButton.setFocusable(false);
        backgroundPanel.add(saveButton);

        // Action listener for save button
        saveButton.addActionListener(e -> {
            String studentID = studentIDField.getText().trim();
            String name = nameField.getText().trim();
            String email = emailField.getText().trim();

            if (studentID.isEmpty() || name.isEmpty()) {
                JOptionPane.showMessageDialog(this, "Student ID and Name are required!", "Error", JOptionPane.ERROR_MESSAGE);
            } else {
                // Create a new Student object
                Student student = new Student(studentID, name, email);

                // Save to database
                StudentDAO studentDAO = new StudentDAO();
                boolean isSaved = studentDAO.addStudent(student);

                if (isSaved) {
                    JOptionPane.showMessageDialog(this, "Student registered successfully!", "Success", JOptionPane.INFORMATION_MESSAGE);
                    dispose(); // Close the frame after saving
                } else {
                    JOptionPane.showMessageDialog(this, "Error while registering student!", "Error", JOptionPane.ERROR_MESSAGE);
                }
            }
        });

        setVisible(true);
    }
}
