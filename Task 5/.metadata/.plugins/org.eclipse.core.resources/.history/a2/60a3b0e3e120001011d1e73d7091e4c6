package ui;

import javax.swing.*;
import java.awt.*;

public class DropCourseFrame extends JFrame {

    public DropCourseFrame() {
        setTitle("Drop Course for Student");
        setSize(700, 500);
        setLayout(null);
        setLocationRelativeTo(null);
        setResizable(false);

        BackgroundPanel backgroundPanel = new BackgroundPanel("/images/drop_bg.jpg");
        setContentPane(backgroundPanel);

        JLabel courseList = new JLabel("Course List:      CS101 for CS, CS102 for Java");
        courseList.setBounds(20, 20, 500, 25);
        courseList.setForeground(Color.BLACK);
        courseList.setFont(new Font("Arial", Font.BOLD, 16));

        JLabel studentLabel = new JLabel("Student ID:");
        studentLabel.setBounds(180, 170, 100, 25);
        studentLabel.setForeground(Color.BLACK);
        studentLabel.setFont(new Font("Arial", Font.BOLD, 16));
        JTextField studentField = new JTextField();
        studentField.setBounds(320, 170, 200, 25);

        JLabel courseLabel = new JLabel("Course Code:");
        courseLabel.setFont(new Font("Arial", Font.BOLD, 16));
        courseLabel.setForeground(Color.BLACK);
        courseLabel.setBounds(180, 200, 130, 25);
        JTextField courseField = new JTextField();
        courseField.setBounds(320, 200, 200, 25);

        JButton submitBtn = new JButton("Drop");
        submitBtn.setBounds(350, 300, 100, 30);
        submitBtn.setBackground(Color.GREEN);
        submitBtn.setFocusable(false);

        add(courseList);
        add(studentLabel);
        add(studentField);
        add(courseLabel);
        add(courseField);
        add(submitBtn);

        submitBtn.addActionListener(e -> {
            String sid = studentField.getText();
            String code = courseField.getText();
            boolean result = new dao.RegistrationDAO().dropStudentFromCourse(sid, code);
            JOptionPane.showMessageDialog(this, result ? "✅ Dropped Successfully!" : "❌ Drop Failed.");
        });

        setVisible(true);
    }
}
